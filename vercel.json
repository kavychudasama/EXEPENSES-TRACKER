{
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/expenses",
      "destination": "/api/index.py"
    },
    {
      "source": "/expenses/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/analytics/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/dashboard",
      "destination": "/api/index.py"
    }
  ]
}
